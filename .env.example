# DataHub environment file (example)
#
# Copy to .env and fill in real values, or let .github/workflows/ec2-deploy.sh
# generate .env on the EC2 host from AWS Secrets Manager.
#
# IMPORTANT: never commit a populated .env. Only this example file is tracked.

# DataHub root user password for user.props (from Secrets Manager: datahub/client-secret)
CLIENT_SECRET=

# Google OIDC credentials (from Secrets Manager: datahub/oidc-credentials)
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# MySQL credentials (from Secrets Manager: datahub/database-credentials)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Pinned DataHub image version (e.g. v1.6.0). Drives all acryldata/* image tags.
DATAHUB_VERSION=

# Token service signing material (from Secrets Manager: datahub/token-service)
# Keep stable across deploys; changing these invalidates existing access tokens.
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=
DATAHUB_TOKEN_SERVICE_SALT=

# Optional integrations (leave empty if unused)
# DATAHUB_ACTIONS_SLACK_BOT_TOKEN=
# DATAHUB_ACTIONS_TEAMS_WEBHOOK_URL=
